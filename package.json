{
  "name": "pinproof",
  "description": "화면에서 찾은 버그·정합성 문제를 증거와 함께 기록해 프로젝트 폴더에 쌓고, Claude Code가 건별로 처리하게 하는 크롬 익스텐션",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "PINPROOF_E2E=1 wxt build && node tests/e2e/run.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
